# Multi-user authentication
# The first successfully registered account becomes SUPERADMIN automatically.
# On upgrade, if no SUPERADMIN exists, the earliest existing account is promoted.
LLM_ALLOW_REGISTRATION=1
LLM_SESSION_DAYS=30
LLM_COOKIE_SECURE=0

# Keep empty for the default localhost/testserver allow-list.
# Example for a LAN reverse proxy:
# LLM_ALLOWED_HOSTS=learning.local,192.168.1.10
LLM_ALLOWED_HOSTS=

# Per-user automatic backups
LLM_AUTO_BACKUP=1
LLM_AUTO_BACKUP_HOURS=24
LLM_AUTO_BACKUP_KEEP=10
LLM_RESTORE_MAX_MB=50

# Coding execution remains disabled by default.
# When running the app directly on a Docker-capable host, see docs/V3.md.
LLM_CODE_RUNNER=disabled
